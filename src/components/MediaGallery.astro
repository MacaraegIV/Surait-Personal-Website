---
<section class="media-gallery section" id="gallery" aria-labelledby="gallery-title">
  <div class="wrap">
    <div class="section-heading"><div><p class="eyebrow">MY CAMERA ROLL</p><h2 id="gallery-title">The moments<br/><span class="blue">I keep.</span></h2></div><p>Food, people, roads, and places.<br/>A more honest look at life outside the profile.</p></div>
    <div class="gallery-grid">
      {photos.slice(0, 6).map((photo, index) => <figure class="gallery-card"><button class="photo-open" data-photo-index={index} aria-label={`Explore photo: ${photo.title}`}><img src={`${base}/media/${photo.file}`} alt={photo.title} loading="lazy" /></button><figcaption><span>{photo.note}</span><strong>{photo.title}</strong></figcaption></figure>)}
    </div>
    <details class="more-photos">
      <summary>Show all photos <span>25 more memories</span></summary>
      <div class="gallery-grid">{photos.slice(6).map((photo, index) => <figure class="gallery-card"><button class="photo-open" data-photo-index={index + 6} aria-label={`Explore photo: ${photo.title}`}><img src={`${base}/media/${photo.file}`} alt={photo.title} loading="lazy" /></button><figcaption><span>{photo.note}</span><strong>{photo.title}</strong></figcaption></figure>)}</div>
    </details>
    <div class="video-row"><article><video controls muted playsinline preload="metadata" aria-label="A memory in motion" poster={`${base}/media/36.jpg`}><source src={`${base}/media/1613.mp4`} type="video/mp4" /></video><p class="eyebrow">MEMORIES / VIDEO 01</p><h3>A memory in motion.</h3></article><article><video controls preload="metadata" poster={`${base}/media/34.jpg`}><source src={`${base}/media/33.mp4`} type="video/mp4" /></video><p class="eyebrow">RIDE LOG / VIDEO 02</p><h3>Rain, roads, and a full crew.</h3></article></div>
  </div>
</section>
<dialog class="photo-viewer" aria-labelledby="viewer-caption">
  <div class="photo-viewer-inner">
    <button class="viewer-close" aria-label="Close photo viewer" autofocus>Close ×</button>
    <img class="viewer-image" alt="" />
    <div class="viewer-toolbar">
      <button class="viewer-previous" aria-label="Previous photo">← Previous</button>
      <div aria-live="polite"><p id="viewer-caption"></p><span class="viewer-count"></span></div>
      <button class="viewer-next" aria-label="Next photo">Next →</button>
    </div>
  </div>
</dialog>
<script>
  const viewer = document.querySelector<HTMLDialogElement>('.photo-viewer');
  const image = viewer?.querySelector<HTMLImageElement>('.viewer-image');
  const caption = viewer?.querySelector<HTMLElement>('#viewer-caption');
  const count = viewer?.querySelector<HTMLElement>('.viewer-count');
  const triggers = Array.from(document.querySelectorAll<HTMLButtonElement>('.photo-open'));
  let current = 0;
  let previousOverflow = '';
  const showPhoto = (index: number) => {
    current = (index + triggers.length) % triggers.length;
    const thumbnail = triggers[current]?.querySelector('img');
    if (!image || !thumbnail) return;
    image.src = thumbnail.src;
    image.alt = thumbnail.alt;
    if (caption) caption.textContent = thumbnail.alt;
    if (count) count.textContent = `${current + 1} / ${triggers.length}`;
  };
  triggers.forEach(trigger => trigger.addEventListener('click', () => {
    if (!viewer) return;
    showPhoto(Number(trigger.dataset.photoIndex));
    previousOverflow = document.body.style.overflow;
    viewer.showModal();
    document.body.style.overflow = 'hidden';
  }));
  viewer?.querySelector('.viewer-close')?.addEventListener('click', () => viewer.close());
  viewer?.querySelector('.viewer-previous')?.addEventListener('click', () => showPhoto(current - 1));
  viewer?.querySelector('.viewer-next')?.addEventListener('click', () => showPhoto(current + 1));
  viewer?.addEventListener('close', () => { document.body.style.overflow = previousOverflow; });
  viewer?.addEventListener('click', event => { if (event.target === viewer) viewer.close(); });
  viewer?.addEventListener('keydown', event => {
    if (event.key === 'ArrowLeft' || event.key === 'ArrowRight') {
      event.preventDefault();
      showPhoto(current + (event.key === 'ArrowLeft' ? -1 : 1));
    }
  });
</script>
